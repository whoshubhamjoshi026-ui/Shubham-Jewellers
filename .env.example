# Server Configuration
PORT=3000
NODE_ENV=development

# Optional: Base URL for backend server
VITE_API_BASE_URL=

# GEMINI_API_KEY: Required for Gemini AI API calls
GEMINI_API_KEY=your_gemini_api_key_here

# Gmail SMTP for Email OTP Authentication
# NOTE: GMAIL_APP_PASSWORD must be a 16-character App Password from Google Account > Security > 2-Step Verification > App passwords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_google_app_password

# Alternative: Resend API for transactional email delivery
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=Shubham Jewellers <onboarding@resend.dev>

# Admin Authentication (Set a strong, private custom PIN)
ADMIN_PIN=change_this_to_a_strong_pin

# Razorpay Payment Gateway (India Online Payments for Gold Savings Scheme)
# Get your API keys from Razorpay Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# MongoDB Atlas Database Connection (Free Tier M0 or above)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/shubham_jewellers?retryWrites=true&w=majority
MONGODB_URI=
